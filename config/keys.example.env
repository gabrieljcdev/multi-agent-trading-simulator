# CryptoBot API Keys — TEMPLATE
# Copy this to keys.env and fill in your real keys
# NEVER commit keys.env to git

# ── Exchanges ──────────────────────────────────────────────
BINANCE_API_KEY=your_binance_api_key_here
BINANCE_SECRET=your_binance_secret_here

KRAKEN_API_KEY=your_kraken_api_key_here
KRAKEN_SECRET=your_kraken_secret_here

BYBIT_API_KEY=your_bybit_api_key_here
BYBIT_SECRET=your_bybit_secret_here

KUCOIN_API_KEY=your_kucoin_api_key_here
KUCOIN_SECRET=your_kucoin_secret_here
KUCOIN_PASSPHRASE=your_kucoin_passphrase_here

# ── Anthropic ──────────────────────────────────────────────
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ── Sentiment ─────────────────────────────────────────────
REDDIT_CLIENT_ID=your_reddit_client_id
REDDIT_CLIENT_SECRET=your_reddit_client_secret
REDDIT_USER_AGENT=cryptobot/1.0

COINMARKETCAP_API_KEY=your_cmc_api_key_here

# Telegram — get via https://my.telegram.org
TELEGRAM_API_ID=your_telegram_api_id
TELEGRAM_API_HASH=your_telegram_api_hash

# ── Data sources (data_sources/) ──────────────────────────
# CoinGecko (free demo or Pro). Free public tier works without a key;
# the demo key just raises rate limits (~30 calls/min).
COINGECKO_API_KEY=your_coingecko_demo_or_pro_key_here

# FRED — fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=your_fred_api_key_here

# Alpha Vantage — alphavantage.co (free 25 calls/day)
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_api_key_here

# CryptoCompare — min-api.cryptocompare.com (free 250k req/month)
CRYPTOCOMPARE_API_KEY=your_cryptocompare_api_key_here
